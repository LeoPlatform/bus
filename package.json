{
	"name": "leo-bus",
	"version": "4.0.0",
	"description": "Improve Kinesis burstability, durability, and replay",
	"main": "index.js",
	"scripts": {
		"test:libs": "mocha --recursive 'test/**/*.test.js'",
		"test:libs:watch": "mocha --recursive -w 'test/**/*.test.js'",
		"test:bots": "mocha --recursive 'bots/**/*.test.js'",
		"test:bots:watch": "mocha --recursive -w 'bots/**/*.test.js'",
		"test:int": "mocha 'test/**/*.integration.js'",
		"setup": "setup",
		"build": "leo-cli publish -s --force all --build",
		"package": "leo-cli publish -s --force all",
		"deploy:dev": "leo-cli publish -s -d dev --force all",
		"deploy:test": "leo-cli publish -s -d test --force all"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LeoPlatform/bus.git"
	},
	"keywords": [
		"Kinesis",
		"Kafka"
	],
	"author": "LeoPlatform",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/LeoPlatform/bus/issues"
	},
	"homepage": "https://github.com/LeoPlatform/bus#readme",
	"dependencies": {
		"@aws-sdk/client-cloudformation": "^3.1022.0",
		"@aws-sdk/client-iam": "^3.1022.0",
		"@aws-sdk/client-lambda": "^3.1022.0",
		"@aws-sdk/client-s3": "^3.1022.0",
		"@aws-sdk/client-sts": "^3.1022.0",
		"@aws-sdk/util-dynamodb": "^3.996.0",
		"deep-diff": "1.0.2",
		"leo-cron": "github:LeoPlatform/leo-cron#5a9836a273edad78891235c24c2db91e3a40090c",
		"leo-logger": "1.0.7",
		"leo-sdk": "7.1.22-awsv3node26.0",
		"moment": "2.24.0"
	},
	"devDependencies": {
		"babel-preset-env": "^1.7.0",
		"chai": "^4.2.0",
		"extend": "^3.0.2",
		"leo-aws": "^4.0.1",
		"mocha": "^6.1.4",
		"proxyquire": "^2.1.1",
		"sinon": "^7.3.2",
		"ajv": "8.11.0",
		"ajv-formats": "2.1.1",
		"is-semver": "1.0.11"
	},
	"config": {
		"leo": {
			"type": "microservice",
			"regions": [
				"us-west-2",
				"us-east-1"
			],
			"runtime": "nodejs26.x",
			"3rdParty": true,
			"excludeProfiles": true
		}
	}
}
